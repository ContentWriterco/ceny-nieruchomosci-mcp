{
  "name": "ceny-nieruchomosci-mcp",
  "version": "0.2.0",
  "description": "MCP server for Polish real estate: real transaction prices from notarial deeds (Rejestr Cen Nieruchomości) and parcel checks – zoning plan (MPZP), utilities, flood risk, nature protection. No API key.",
  "type": "module",
  "bin": {
    "ceny-nieruchomosci-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch(e){}\"",
    "test": "npm run build && node --test test/unit.test.mjs test/parcel.test.mjs",
    "prepublishOnly": "npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nieruchomosci",
    "ceny-mieszkan",
    "rejestr-cen-nieruchomosci",
    "rcn",
    "real-estate",
    "poland",
    "housing-prices",
    "gugik",
    "open-data",
    "claude",
    "ai-agent",
    "dzialka",
    "mpzp",
    "plan-miejscowy",
    "uzbrojenie",
    "parcel",
    "zoning"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContentWriterco/ceny-nieruchomosci-mcp.git"
  },
  "homepage": "https://ceny.compabase.com",
  "bugs": {
    "url": "https://github.com/ContentWriterco/ceny-nieruchomosci-mcp/issues"
  },
  "mcpName": "io.github.ContentWriterco/ceny-nieruchomosci-mcp"
}
